PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration for pgAdmin 4
PGHOST=localhost
PGPORT=5432
PGDATABASE=cricket
PGUSER=postgres
PGPASSWORD=your_password_here

# Used to sign scorer desk sessions. Use a unique random value in production.
AUTH_SECRET=

# Used only when no super-admin account exists. Change these in production.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Allowed CORS origins
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173
